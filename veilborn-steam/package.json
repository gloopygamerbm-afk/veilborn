{
  "name": "veilborn",
  "version": "0.1.0",
  "description": "Veilborn - a creepy gothic platformer",
  "main": "main.js",
  "author": "You",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourstudio.veilborn",
    "productName": "Veilborn",
    "files": ["index.html", "main.js", "js/**/*", "lib/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "dir" },
    "mac": { "target": "dir" },
    "linux": { "target": "dir" }
  }
}
